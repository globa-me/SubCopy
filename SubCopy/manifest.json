{
  "manifest_version": 3,
  "name": "SubCopy",
  "version": "1.0",
  "description": "Copy visible YouTube subtitles to clipboard. Developed by Gennadiy Zakharov and Ivan Kononov.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ]
}